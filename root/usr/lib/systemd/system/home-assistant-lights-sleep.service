[Unit]
Description=Turn Home Assistant lights off on suspend and on after resume
# Started before suspend/hibernate; stopped again once sleep.target is left
# on resume, which runs ExecStop.
Before=sleep.target
StopWhenUnneeded=yes
ConditionPathExists=/etc/home-assistant-lights.env

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/home-assistant-lights.env
# Few retries before sleeping so suspend is not held up.
ExecStart=/usr/bin/env HA_LIGHTS_RETRIES=1 /usr/libexec/home-assistant-lights off
# The network may take a while to come back after resume.
ExecStop=/usr/bin/env HA_LIGHTS_RETRIES=15 /usr/libexec/home-assistant-lights on
TimeoutStartSec=30
TimeoutStopSec=90

[Install]
WantedBy=sleep.target
