# Copy to /etc/home-assistant-lights.env and restrict it to root:
#   sudo install -m600 /usr/share/home-assistant-lights/home-assistant-lights.env.example /etc/home-assistant-lights.env
# Each URL is a Home Assistant webhook trigger; it is called with POST.
# Leave one empty to skip that action.
HA_LIGHTS_ON_URL=https://homeassistant.example.com/api/webhook/REPLACE_WITH_ON_WEBHOOK_ID
HA_LIGHTS_OFF_URL=https://homeassistant.example.com/api/webhook/REPLACE_WITH_OFF_WEBHOOK_ID

# Optional: only call the webhooks while connected to one of these Wi-Fi
# networks (comma separated SSIDs). Leave empty to always call them. When set,
# wired-only connections are treated as "not allowed".
HA_LIGHTS_WIFI_SSIDS=
# Seconds to wait for Wi-Fi to connect after boot/resume before giving up.
#HA_LIGHTS_WIFI_WAIT=30
